menu "ST7796 LCD Configuration"

    config LCD_MOSI_GPIO
        int "MOSI (SDA) GPIO Pin"
        default 11
        help
            GPIO connected to ST7796 SDA/MOSI pin.

    config LCD_MISO_GPIO
        int "MISO GPIO Pin"
        default 13
        help
            GPIO connected to ST7796 MISO pin (-1 if not used).

    config LCD_SCLK_GPIO
        int "SCLK (SCL) GPIO Pin"
        default 12
        help
            GPIO connected to ST7796 SCL/SCK pin.

    config LCD_CS_GPIO
        int "CS GPIO Pin"
        default 10
        help
            GPIO connected to ST7796 CS pin (-1 if tied to GND).

    config LCD_DC_GPIO
        int "DC (Data/Command) GPIO Pin"
        default 9
        help
            GPIO connected to ST7796 DC pin.

    config LCD_RST_GPIO
        int "RST (Reset) GPIO Pin"
        default 14
        help
            GPIO connected to ST7796 RES/RST pin (-1 if tied to 3.3V).

    config LCD_BLK_GPIO
        int "Backlight (BLK) GPIO Pin"
        default 2
        help
            GPIO connected to ST7796 BLK pin (GPIO 2 on typical board).

    config LCD_WIDTH
        int "Screen Width (Pixels)"
        default 480
        help
            TFT LCD horizontal resolution in pixels.

    config LCD_HEIGHT
        int "Screen Height (Pixels)"
        default 320
        help
            TFT LCD vertical resolution in pixels.

    config LCD_SPI_CLOCK_HZ
        int "SPI Clock Speed (Hz)"
        default 80000000
        help
            SPI Clock speed (e.g. 80000000 = 80 MHz, 40000000 = 40 MHz).

endmenu
